{
	"name": "Gmail Pipeline",
	"properties": {
		"activities": [
			{
				"name": "receiver",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "receiveraddress",
					"value": {
						"value": "@pipeline().globalParameters.receiver",
						"type": "Expression"
					}
				}
			},
			{
				"name": "WebHTTP",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "receiver",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set header",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set Footer",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": "https://prod-12.northcentralus.logic.azure.com:443/workflows/8f00ab36bf4f4a68924d30beb6d650ee/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=DT0EHb7z7G2opjll4kGOJeCYa07Tc-80BnSX3QhWJHQ",
					"body": {
						"value": "{\n    \"Header\" : \"@{variables('header')}\",\n    \"Footer\" : \"@{variables('footer')}\",\n    \"Azure DataFactory Name\" : \"@{pipeline().DataFactory}\",\n    \"Receiver Address\" : \"@{pipeline().globalParameters.receiver}\",\n    \"pipeline Name\" : \"@{pipeline().Pipeline}\",\n    \"Pipeline RunID\" : \"@{pipeline().RunId}\",\n    \"pipeline Status\" : \"SUCCESS\",\n    \"Status Record Time\" : \"@{utcNow()}\",\n    \"Fail Record\" : \"@{activity('Table output').output.record_count}\"\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set header",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "header",
					"value": {
						"value": "Ingestion and TRansformation process for caresync project has been completed and below is the status",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set Footer",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "footer",
					"value": {
						"value": "For any support please contact to @{pipeline().globalParameters.receiver}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Read All tables status",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT * FROM ctrl.audit_log\nWHERE adf_run_id = '@{pipeline().parameters.pipelinerunid}';",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTableds",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			}
		],
		"parameters": {
			"pipelinerunid": {
				"type": "string"
			}
		},
		"variables": {
			"receiveraddress": {
				"type": "String"
			},
			"header": {
				"type": "String"
			},
			"footer": {
				"type": "String"
			}
		},
		"annotations": []
	}
}