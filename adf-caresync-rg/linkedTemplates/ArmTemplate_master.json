{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-caresync-rg"
		},
		"caresyncstoragegen2LS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'caresyncstoragegen2LS'"
		},
		"AzureDatabricksLS_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1120-195042-qv1k0t5u"
		},
		"AzureKeyVaultLS_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://caresync-rg-keyvault.vault.azure.net/"
		},
		"AzureSqlDatabaseds_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlservercarsync.database.windows.net"
		},
		"AzureSqlDatabaseds_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb"
		},
		"AzureSqlDatabaseds_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Aajjiitt11"
		},
		"PostgreSqlLS_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-twilight-waterfall-aok75v22-pooler.c-2.ap-southeast-1.aws.neon.tech"
		},
		"PostgreSqlLS_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"PostgreSqlLS_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"caresyncstoragegen2LS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://caresyncstoragegen2.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-caresync-rg_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"caresyncstoragegen2LS_accountKey": {
						"value": "[parameters('caresyncstoragegen2LS_accountKey')]"
					},
					"AzureKeyVaultLS_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVaultLS_properties_typeProperties_baseUrl')]"
					},
					"caresyncstoragegen2LS_properties_typeProperties_url": {
						"value": "[parameters('caresyncstoragegen2LS_properties_typeProperties_url')]"
					},
					"AzureDatabricksLS_properties_typeProperties_existingClusterId": {
						"value": "[parameters('AzureDatabricksLS_properties_typeProperties_existingClusterId')]"
					},
					"AzureSqlDatabaseds_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabaseds_properties_typeProperties_server')]"
					},
					"AzureSqlDatabaseds_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabaseds_properties_typeProperties_database')]"
					},
					"AzureSqlDatabaseds_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabaseds_properties_typeProperties_userName')]"
					},
					"PostgreSqlLS_properties_typeProperties_server": {
						"value": "[parameters('PostgreSqlLS_properties_typeProperties_server')]"
					},
					"PostgreSqlLS_properties_typeProperties_database": {
						"value": "[parameters('PostgreSqlLS_properties_typeProperties_database')]"
					},
					"PostgreSqlLS_properties_typeProperties_username": {
						"value": "[parameters('PostgreSqlLS_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}